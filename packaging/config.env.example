# Optional Home Assistant integration. Leave HA_URL empty to disable.
HA_URL=
HA_TOKEN=
# Comma-separated list of light entity_ids that should turn red on mute.
HA_LIGHTS=
# Optional fallback automation triggered on unmute when HA's snapshot of the
# lights looks bogus (HA's Hue integration occasionally returns xy=[0,0]).
# If set, the automation is fired instead of restoring per-light.
HA_FALLBACK_AUTOMATION=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
